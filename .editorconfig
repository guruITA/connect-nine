# Layout for every editor, rule 2 of docs/team/codeConventions.md.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{ts,tsx,js,jsx,json,yml,yaml,md,css}]
indent_size = 2

[*.cs]
indent_size = 4

# Rule 15 of the code conventions: a log line uses a message template, never $"...".
# CA2254 finds a template that is not a fixed text, and TreatWarningsAsErrors stops the build (#312).
dotnet_diagnostic.CA2254.severity = warning

# EF Core writes migrations itself, with a byte order mark; dotnet format leaves generated code alone.
[**/Migrations/*.cs]
generated_code = true
