# Only Docker Compose reads this file, for docker-compose.yml in this folder. The server (dotnet run)
# does not: it reads its own settings from dotnet user-secrets and appsettings.Development.json,
# see docs/team/onboarding.md.
# Copy this file once and name the copy .env. Then put your own password in .env, never in this file.

# The database user that is created and owns the database. Keep connect, the docs use it everywhere.
POSTGRES_USER=connect
# The password of that user, also used by pgAdmin. Choose your own in .env; it never leaves your laptop.
POSTGRES_PASSWORD=change-me
# The name of the database that is created. Keep connect, the docs use it everywhere.
POSTGRES_DB=connect

# The first pgAdmin user. pgAdmin runs without a login page, but the image will not start without it.
PGADMIN_EMAIL=connect@example.org

# The port of Connect on this computer when it runs as containers with
# docker compose --profile app up -d --build. Change it when 8080 is already taken.
SERVER_PORT=8080
