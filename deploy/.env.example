# The secret settings of the test site. The real file is /srv/connect-test/.env on the server,
# rights 600, owner deploy, and never in Git (task 9.5, #240). Values here are placeholders.
# The user and the name of the test database.
POSTGRES_USER=connect
POSTGRES_DB=connect
# The password of the test database, made on the server with: openssl rand -hex 24
POSTGRES_PASSWORD=<made on the server>
# How the Connect server reaches the database: the same user, name and password, Host is the compose service.
ConnectionStrings__DefaultConnection=Host=database;Port=5432;Database=connect;Username=connect;Password=<the same password>
# Minutes without activity before a session on the test site ends.
Session__IdleMinutes=30

# Whether the server adds the made up test member at start. Never true on the live site.
Seeding__TestData=false
# The password of the test member. The masked GitLab variable SEEDING_TEST_MEMBER_PASSWORD
# fills this in pipeline.env once the deploy of #267 exists, never here.
Seeding__TestMemberPassword=
